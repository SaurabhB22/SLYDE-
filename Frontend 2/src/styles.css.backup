
:root{
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
  --paper:#E9EEE8; --panel:#F6F8F3; --ink:#14231D; --muted:#4B5B54; --line:#C6D0C7;
  --accent:#27594A; --accent-ink:#FFFFFF; --focus:#0B5FD6; --field:#FFFFFF;
  --low:#2E7D52; --mod:#E8B923; --high:#C4561A; --crit:#A81F18;
  --low-ink:#FFFFFF; --mod-ink:#2B2200; --high-ink:#FFFFFF; --crit-ink:#FFFFFF;
  --glass:rgba(246,248,243,.92);
  --head:'Bricolage Grotesque',Georgia,'Times New Roman',serif;
  --body:'Source Sans 3',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --paper:#0E1714; --panel:#15221D; --ink:#E6EEE8; --muted:#9FB2A8; --line:#2B3D35;
    --accent:#7CC4A0; --accent-ink:#0E1714; --focus:#7DB2FF; --field:#0F1B17; --glass:rgba(21,34,29,.92);
  }
}
:root[data-theme="dark"]{
  --paper:#0E1714; --panel:#15221D; --ink:#E6EEE8; --muted:#9FB2A8; --line:#2B3D35;
  --accent:#7CC4A0; --accent-ink:#0E1714; --focus:#7DB2FF; --field:#0F1B17; --glass:rgba(21,34,29,.92);
}
html{height:100%;scroll-padding-top:env(safe-area-inset-top,0px)}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;height:100%;background:var(--paper);color:var(--ink);font-family:var(--body);font-size:16px;line-height:1.45}
:focus-visible{outline:3px solid var(--focus);outline-offset:2px}
button,select,input{font:inherit;color:inherit}
button{cursor:pointer}
.app{height:100%;display:grid;grid-template-columns:392px minmax(0,1fr);grid-template-rows:minmax(0,1fr)}
@media (max-width:900px){.app{display:block;height:auto}}

/* side panel */
.side{background:var(--panel);border-right:1px solid var(--line);overflow-y:auto;min-height:0}
@media (max-width:900px){.side{border-right:0;border-top:1px solid var(--line)}}
.sec{padding:14px 16px;border-bottom:1px solid var(--line)}
.sec h2{font-family:var(--head);font-size:19px;font-weight:700;margin:0 0 8px;letter-spacing:-.005em}
.brand{display:flex;gap:12px;align-items:center;padding:14px 16px;border-bottom:1px solid var(--line)}
.brand h1{font-family:var(--head);font-size:26px;line-height:1;margin:0;font-weight:700}
.brand p{margin:2px 0 0;color:var(--muted);font-size:14px}
.demo{margin:0;padding:8px 16px;background:color-mix(in srgb,var(--mod) 22%,var(--panel));border-bottom:1px solid var(--line);font-size:13.5px}
label,.lbl{display:block;font-weight:600;font-size:14px;margin-bottom:4px}
select{width:100%;min-height:40px;padding:7px 10px;background:var(--field);border:1px solid var(--line);border-radius:6px}
.chips{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 8px}
.chip{border:1px solid var(--line);background:var(--field);border-radius:999px;padding:4px 11px;font-size:14px;min-height:32px}
.chip[aria-pressed="true"]{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
.slider{margin:7px 0 9px}
.slider .t{display:flex;justify-content:space-between;gap:8px;font-size:14px;font-weight:600}
.slider output{font-variant-numeric:tabular-nums;color:var(--muted);text-align:right}
input[type=range]{width:100%;accent-color:var(--accent);min-height:26px;margin:0}
.hint{font-size:13.5px;color:var(--muted);margin:6px 0 0}
.btn{display:inline-flex;align-items:center;gap:6px;min-height:36px;padding:5px 12px;border-radius:7px;border:1px solid var(--line);background:var(--field);font-weight:600;font-size:14px}
.btn:hover{border-color:var(--accent)}
.btn[aria-pressed="true"]{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}

/* result */
.result{border:1px solid var(--line);border-radius:8px;overflow:hidden;margin-top:10px}
.band{display:flex;justify-content:space-between;align-items:baseline;gap:10px;padding:10px 14px}
.band .lv{font-family:var(--head);font-weight:700;font-size:32px;line-height:1.05}
.band .pc{text-align:right;font-weight:600;font-size:14px}
.band .pc b{font-size:22px;font-variant-numeric:tabular-nums}
.lv-0{background:var(--low);color:var(--low-ink)}.lv-1{background:var(--mod);color:var(--mod-ink)}.lv-2{background:var(--high);color:var(--high-ink)}.lv-3{background:var(--crit);color:var(--crit-ink)}
.rbody{padding:12px 14px;background:var(--field)}
.place{margin:0;font-weight:700;font-size:17px}
.place small{font-weight:400;color:var(--muted);font-size:14px}
.meta{margin:2px 0 8px;font-size:14px;color:var(--muted)}
.flag{margin:8px 0;padding:8px 10px;border:1px solid var(--line);border-radius:6px;font-size:14px}
.flag.warn{border-color:var(--high);background:color-mix(in srgb,var(--high) 12%,transparent)}
.flag.site{border-color:var(--crit);background:color-mix(in srgb,var(--crit) 10%,transparent)}
.drivers{list-style:none;margin:8px 0 0;padding:0;display:grid;gap:6px}
.drivers li{display:grid;grid-template-columns:128px 1fr 74px;gap:8px;align-items:center;font-size:14px}
.bar{height:8px;background:var(--line);border-radius:4px;overflow:hidden}
.bar i{display:block;height:100%;background:var(--accent)}
.v{text-align:right;font-variant-numeric:tabular-nums;color:var(--muted)}
.thr{font-size:13.5px;color:var(--muted);margin:10px 0 0}

/* lists */
.sites{list-style:none;margin:0;padding:0;display:grid;gap:6px}
.sites button{width:100%;text-align:left;background:var(--field);border:1px solid var(--line);border-radius:7px;padding:8px 10px}
.sites button:hover{border-color:var(--accent)}
.sites b{display:block;font-size:15px}
.sites span{display:block;font-size:13.5px;color:var(--muted)}
.sites .rec{color:var(--ink)}
.tag{display:inline-block;margin-right:6px;padding:0 7px;border-radius:999px;background:var(--crit);color:var(--crit-ink);font-size:12px;font-weight:700}
details{border:1px solid var(--line);border-radius:7px;background:var(--field);margin-top:6px}
details summary{padding:8px 10px;font-weight:600;cursor:pointer}
details div{padding:0 10px 10px;font-size:14px}
details ul{margin:6px 0 0;padding-left:18px}
details li{margin-bottom:4px}
a{color:var(--accent);font-weight:600}

/* stage */
.stage{position:relative;min-width:0;min-height:0;background:var(--paper)}
@media (max-width:900px){.stage{height:66vh;min-height:420px}}
#gl{position:absolute;inset:0;width:100%;height:100%;display:block;touch-action:none;cursor:grab}
#gl:active{cursor:grabbing}
.labels{position:absolute;inset:0;overflow:hidden;pointer-events:none}
.lab{position:absolute;left:0;top:0;pointer-events:auto;border:0;background:none;padding:0;display:flex;align-items:center;gap:5px;white-space:nowrap;transform:translate(-100px,-100px);will-change:transform}
.lab i{width:8px;height:8px;border-radius:50%;background:var(--ink);border:2px solid var(--panel);flex:none}
.lab span{font-size:12.5px;font-weight:700;color:var(--ink);text-shadow:0 0 3px var(--panel),0 0 3px var(--panel),0 0 3px var(--panel)}
.lab.hq i{width:11px;height:11px;border-radius:2px;transform:rotate(45deg)}
.lab.site i{background:var(--accent)}
.lab.hot i{width:13px;height:13px;border-radius:2px;transform:rotate(45deg);background:var(--high);border-color:var(--panel)}
.lab.hot.recent i{background:var(--crit);box-shadow:0 0 0 3px color-mix(in srgb,var(--crit) 35%,transparent)}
.lab.glof i{background:#2B7BC4;border-radius:2px}
.lab.sel i{width:15px;height:15px;background:var(--accent);border-color:#fff;box-shadow:0 0 0 3px var(--accent)}
.lab.sel span{font-size:14px}
.hud{position:absolute;pointer-events:none}
.bar-top{position:absolute;left:12px;right:12px;top:calc(12px + env(safe-area-inset-top,0px));display:flex;flex-wrap:wrap;gap:8px;justify-content:space-between;pointer-events:none}
.group{display:flex;flex-wrap:wrap;gap:6px;background:var(--glass);border:1px solid var(--line);border-radius:10px;padding:6px;pointer-events:auto}
.group .btn{min-height:34px;padding:3px 10px;font-size:13.5px}
.layers{display:flex;flex-wrap:wrap;gap:4px 14px;align-items:center;font-size:13.5px}
.layers label{display:inline-flex;gap:5px;align-items:center;margin:0;font-weight:600;font-size:13.5px}
.layers input{accent-color:var(--accent);width:16px;height:16px}
.legend{position:absolute;left:12px;bottom:calc(12px + env(safe-area-inset-bottom,0px));background:var(--glass);border:1px solid var(--line);border-radius:10px;padding:8px 10px;font-size:13px;pointer-events:none;max-width:230px}
.legend b{display:block;margin-bottom:4px;font-size:13px}
.legend div{display:flex;align-items:center;gap:6px;line-height:1.5}
.legend i{width:14px;height:14px;border-radius:3px;flex:none}
.grad{height:12px;border-radius:3px;margin:4px 0 2px;border:1px solid var(--line)}
.legend small{display:flex;justify-content:space-between;color:var(--muted)}
.exag{position:absolute;right:12px;bottom:calc(12px + env(safe-area-inset-bottom,0px));background:var(--glass);border:1px solid var(--line);border-radius:10px;padding:8px 10px;font-size:13px;width:190px}
.exag label{display:flex;justify-content:space-between;margin:0;font-size:13px}
.exag p{margin:4px 0 0;font-size:12.5px;color:var(--muted)}
.msg{position:absolute;inset:0;display:none;place-items:center;text-align:center;padding:24px;background:var(--paper);z-index:3}
.msg.on{display:grid}
.toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--ink);color:var(--paper);padding:9px 15px;border-radius:8px;font-size:15px;max-width:90vw;opacity:0;pointer-events:none;transition:opacity .18s;z-index:9}
.toast.on{opacity:1}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
@media (max-width:600px){.legend{max-width:165px;font-size:12px}.exag{width:150px}.exag p{display:none}.lab span{font-size:11.5px}}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}



/* emergency contact directory */
.helpline-sec{background:color-mix(in srgb,var(--panel) 94%,var(--accent) 6%)}
.helpline-grid{display:grid;gap:7px;margin-top:10px}
.helpline-card{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;padding:10px;border:1px solid var(--line);border-radius:8px;background:var(--field)}
.helpline-card>div:first-child{display:grid;gap:2px;min-width:0;flex:1}
.helpline-card b{font-size:14px}
.helpline-card span{font-size:12.5px;color:var(--muted)}
.helpline-card>a{display:inline-flex;align-items:center;gap:6px;white-space:nowrap;border:1px solid var(--line);border-radius:7px;padding:5px 8px;text-decoration:none;font-size:14px;font-weight:700;background:var(--panel)}
.helpline-card>a span{color:inherit;font-size:12px}
.helpline-card.urgent{border-color:var(--crit);background:color-mix(in srgb,var(--crit) 7%,var(--field))}
.helpline-card.urgent>a{background:var(--crit);border-color:var(--crit);color:#fff;font-size:18px}
.helpline-card.state-control{margin-top:7px;display:block}
.helpline-actions{display:flex;flex-wrap:wrap;gap:6px;margin-top:7px}
.helpline-actions a{border:1px solid var(--line);border-radius:6px;padding:5px 7px;text-decoration:none;background:var(--panel);font-size:13px}
.helpline-subhead{font-size:15px;margin:14px 0 5px}
.district-helplines details{margin-top:5px}
.district-helplines details div p{margin:0 0 4px;color:var(--muted);font-size:13px}
.district-helplines details div a{display:inline-block;padding:4px 0;text-decoration:none}
.helpline-source{margin-top:10px;font-size:12px}

/* Illustrative Three.js landslide-motion control */
.slide-anim-toggle[aria-pressed="true"]{background:#A81F18!important;color:#fff!important;border-color:#A81F18!important;box-shadow:0 0 0 2px rgba(168,31,24,.18)}
.slide-anim-note{position:absolute;left:12px;right:12px;top:58px;z-index:3;max-width:540px;padding:8px 11px;border:1px solid #C4561A;border-radius:8px;background:rgba(255,248,235,.95);color:#6c2a0b;font-size:12px;font-weight:650;box-shadow:0 2px 10px rgba(0,0,0,.08);pointer-events:none}
@media (max-width:900px){.slide-anim-note{top:104px;left:8px;right:8px;font-size:11px}.slide-anim-toggle{white-space:nowrap}}
